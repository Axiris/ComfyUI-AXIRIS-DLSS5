      "properties": {},
      "widgets_values": [
        "AXIRIS DLSS 5 — video finishing of a shot\n\nLoad Video → DLSS 5 Video finishing (Merserk Visual Enhancer v15 video pipeline: temporal history, scene cuts, motion computed by the engine — optical_flow High = steadiest) → Save Video + Before/After slider.\nDefaults = the AXIRIS look. Measured on cinematic shots: no added shimmer, brightness kept.\nThe shot goes through RAM as frames: fine for shots, not for minutes-long films."
      ],
      "widgets_values_named": {
        "text": "AXIRIS DLSS 5 — video finishing of a shot\n\nLoad Video → DLSS 5 Video finishing (Merserk Visual Enhancer v15 video pipeline: temporal history, scene cuts, motion computed by the engine — optical_flow High = steadiest) → Save Video + Before/After slider.\nDefaults = the AXIRIS look. Measured on cinematic shots: no added shimmer, brightness kept.\nThe shot goes through RAM as frames: fine for shots, not for minutes-long films."
      },
      "color": "#432",
      "bgcolor": "#653"
    },
