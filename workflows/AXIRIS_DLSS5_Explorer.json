   "properties": {},
   "widgets_values": [
    "AXIRIS DLSS 5 — Explorer: every variant at once\n\n1. Put your image in Load Image, run.\n2. « board »: the source then each variant, at 100 % on the zone (zone_x / zone_y in %), its settings written under it.\n3. Click a tile of the board, or an image in Save Image: the Before/After slider shows that variant.\nOne variant per line: a preset name, or « my test: passes=1 intensity=0.85 local_tone=1.5 »."
   ],
   "widgets_values_named": {
    "text": "AXIRIS DLSS 5 — Explorer: every variant at once\n\n1. Put your image in Load Image, run.\n2. « board »: the source then each variant, at 100 % on the zone (zone_x / zone_y in %), its settings written under it.\n3. Click a tile of the board, or an image in Save Image: the Before/After slider shows that variant.\nOne variant per line: a preset name, or « my test: passes=1 intensity=0.85 local_tone=1.5 »."
   },
