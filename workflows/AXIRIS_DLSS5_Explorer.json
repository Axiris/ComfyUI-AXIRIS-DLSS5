      "properties": {},
      "widgets_values": [
        "AXIRIS DLSS 5 — Explorer: every variant at once\n\n1. Put your image in Load Image, run.\n2. « board »: the source then each variant, at 100 % on the zone (zone_x / zone_y in %), its settings written under it.\n3. Click a tile of the board, or an image in Save Image: the Before/After slider shows that variant.\nOne variant per line: a preset name, or « my test: intensity=1.1 local_tone=0.7 style=Style 1 »."
      ],
      "widgets_values_named": {
        "text": "AXIRIS DLSS 5 — Explorer: every variant at once\n\n1. Put your image in Load Image, run.\n2. « board »: the source then each variant, at 100 % on the zone (zone_x / zone_y in %), its settings written under it.\n3. Click a tile of the board, or an image in Save Image: the Before/After slider shows that variant.\nOne variant per line: a preset name, or « my test: intensity=1.1 local_tone=0.7 style=Style 1 »."
      },
      "color": "#432",
      "bgcolor": "#653"
    },
